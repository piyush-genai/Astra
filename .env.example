# Upstox API Credentials
# Get these from: https://developer.upstox.com/

# Live Trading Credentials (NEVER use in development)
UPSTOX_LIVE_API_KEY=your_live_api_key_here
UPSTOX_LIVE_API_SECRET=your_live_api_secret_here
UPSTOX_LIVE_REDIRECT_URI=https://your-callback-url.com/callback

# Analytics Token (read-only market data, valid 1 year)
# Generate from: Developer Console > Analytics tab
UPSTOX_ANALYTICS_TOKEN=your_analytics_token_here

# Sandbox Testing Credentials (safe for development)
UPSTOX_SANDBOX_API_KEY=your_sandbox_api_key_here
UPSTOX_SANDBOX_API_SECRET=your_sandbox_api_secret_here
UPSTOX_SANDBOX_REDIRECT_URI=https://your-callback-url.com/sandbox/callback
UPSTOX_SANDBOX_ACCESS_TOKEN=your_sandbox_token_here

# Telegram Bot (optional, for kill switch and trade alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
