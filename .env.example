# ASTRA environment template — copy to .env and fill in.
#   cp .env.example .env
#
# .env is gitignored and must stay that way (AGENTS.md section 9).
# Never commit real values. Never log these, even in debug output.
#
# Every name below is one the code actually reads. Verified against the source
# on 2026-10-13 — an earlier list in HANDOFF.md named variables that nothing
# reads. If you add a variable, add it here too.

# ── Historical data (DATA-001) ────────────────────────────────────────────────
# Required by: scripts/data_001_fetch_historical.py
# This is the only credential needed to rebuild the 2023-2025 NIFTY 5-min CSV,
# which every experiment from EXP-0009 onward depends on. Upstox Analytics API.
UPSTOX_ANALYTICS_TOKEN=

# ── Live Upstox app (OAuth) ───────────────────────────────────────────────────
# Required by: scripts/auth.py, scripts/test_data.py
UPSTOX_LIVE_API_KEY=
UPSTOX_LIVE_API_SECRET=
UPSTOX_LIVE_REDIRECT_URI=

# Daily OAuth access token produced by scripts/auth.py. Expires every day.
# Required by: scripts/debug_token.py, live/paper sessions that hit the API.
UPSTOX_ACCESS_TOKEN=

# ── Sandbox Upstox app ────────────────────────────────────────────────────────
# Required by: scripts/run_backtest.py, scripts/export_ohlcv_data.py,
#              scripts/test_sandbox.py
UPSTOX_SANDBOX_API_KEY=
UPSTOX_SANDBOX_API_SECRET=
UPSTOX_SANDBOX_REDIRECT_URI=
UPSTOX_SANDBOX_ACCESS_TOKEN=

# ── Telegram monitoring ───────────────────────────────────────────────────────
# Required by: scripts/telegram_bot.py, live/monitor.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SEBI Algo-ID ──────────────────────────────────────────────────────────────
# NOT an environment variable, despite what HANDOFF.md section 3 says. No Python
# file reads ALGO_ID. The Algo-ID lives in config/risk.yaml under:
#
#   algo_ids:
#     pivot_cpr_strategy: null   # ← fill in after registering with Upstox
#
# It is still null, so no strategy is registered. Mandatory for automated order
# placement from April 2026 (HANDOFF.md RISK-4). Setting an ALGO_ID env var here
# would achieve nothing — put it in config/risk.yaml instead.
